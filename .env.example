# ── Database ──────────────────────────────────────────────
POSTGRES_USER=ncf_user
POSTGRES_PASSWORD=ncf_pass
POSTGRES_DB=ncf_db
DATABASE_URL=postgresql://ncf_user:ncf_pass@db:5432/ncf_db

# ── Auth ──────────────────────────────────────────────────
SECRET_KEY=change-me-super-secret-key-min-32-characters!!
ACCESS_TOKEN_EXPIRE_MINUTES=60

# ── TMDB (optional — for poster images) ──────────────────
TMDB_API_KEY=your_tmdb_api_key_here

# ── Services ──────────────────────────────────────────────
MODEL_SERVER_URL=http://model_server:8001
CORS_ORIGINS=http://localhost:3000

# ── App ───────────────────────────────────────────────────
APP_ENV=development

# ── Frontend ──────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:8000
