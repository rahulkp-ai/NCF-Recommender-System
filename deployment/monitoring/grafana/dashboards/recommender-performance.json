{
  "title": "Recommender Performance",
  "uid": "ncf-recommender-performance",
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "10s",
  "time": { "from": "now-1h", "to": "now" },
  "panels": [
    {
      "id": 1,
      "title": "Recommendation Requests (rate, by endpoint)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "targets": [
        {
          "expr": "sum(rate(http_requests_total{service=\"backend\", path=~\"/api/v1/recommend.*|/api/v1/search.*\"}[1m])) by (path)",
          "legendFormat": "{{path}}"
        }
      ]
    },
    {
      "id": 2,
      "title": "Strategy Distribution (rate)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "targets": [
        {
          "expr": "sum(rate(recommendation_strategy_total[1m])) by (strategy)",
          "legendFormat": "{{strategy}}"
        }
      ]
    },
    {
      "id": 3,
      "title": "Strategy Share (last 1h, total count)",
      "type": "piechart",
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 8 },
      "targets": [
        {
          "expr": "sum(increase(recommendation_strategy_total[1h])) by (strategy)",
          "legendFormat": "{{strategy}}"
        }
      ]
    },
    {
      "id": 4,
      "title": "Recommend Endpoint Latency P95",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 8 },
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(http_request_duration_seconds_bucket{service=\"backend\", path=~\"/api/v1/recommend.*\"}[5m])) by (le, path))",
          "legendFormat": "{{path}}"
        }
      ]
    },
    {
      "id": 5,
      "title": "Model Server Inference Latency P95",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 8 },
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(http_request_duration_seconds_bucket{service=\"model_server\"}[5m])) by (le, path))",
          "legendFormat": "{{path}}"
        }
      ]
    },
    {
      "id": 6,
      "title": "Recommend Endpoint Error Rate",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 16 },
      "targets": [
        {
          "expr": "sum(rate(http_requests_total{service=\"backend\", path=~\"/api/v1/recommend.*\", status=~\"4..|5..\"}[1m])) by (path, status)",
          "legendFormat": "{{path}} {{status}}"
        }
      ]
    },
    {
      "id": 7,
      "title": "Total Recommendations Served (by strategy)",
      "type": "stat",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 16 },
      "targets": [
        {
          "expr": "sum(recommendation_strategy_total) by (strategy)",
          "legendFormat": "{{strategy}}"
        }
      ]
    }
  ]
}
